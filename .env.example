# Required: one of these two. The setup page sets MCP_SECRET_SHA256, the
# SHA-256 fingerprint (hex) of your secret, so Vercel never holds the secret.
# It wins when both are set. For local development MCP_SECRET, the secret
# itself, is simpler: at least 32 URL-safe characters, e.g. `openssl rand -hex 32`.
MCP_SECRET_SHA256=
MCP_SECRET=

# Local development only. On Vercel the deployment's OIDC token is used instead.
# `vercel env pull` also writes a VERCEL_OIDC_TOKEN (valid ~12 hours).
AI_GATEWAY_API_KEY=

# Set automatically when a Blob store is connected to the project.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Optional per-call caps.
MAX_VIDEO_SECONDS=8
MAX_IMAGES_PER_CALL=4
MAX_SPEECH_CHARACTERS=5000
# Comma-separated model ids; empty allows all.
ALLOWED_MODELS=
# Lifetime of file links in hours (max 168).
SIGNED_URL_TTL_HOURS=24

# `instance` (setup page, default) or `landing` (project landing page).
SITE_MODE=instance
